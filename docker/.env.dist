# The sources' settings: copy to .env (git-ignored), fill in what you have.
# `docker compose run --rm omnilex sources` says what is installed and configured.

# Where the sources' checkouts are, when this core sits in the workspace
# beside them (../.. from this directory); unset, they come from GitHub.
#OMNILEX_PLUGINS=../..

# PISTE (piste.gouv.fr): the OAuth credentials of an application subscribed
# to the Légifrance and Judilibre APIs. Free; see the READMEs of
# omnilex/legifrance and omnilex/judilibre for the steps.
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=
# 1 when the credentials are those of the sandbox application.
PISTE_SANDBOX=

# EUR-Lex: the language of the titles and texts (ISO 639-1). No key.
EURLEX_LANGUAGE=fr

# The administrative courts' open data needs nothing.
